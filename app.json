{
  "expo": {
    "name": "케세헌",
    "slug": "k-sales-hunter-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ksaleshunter",
    "userInterfaceStyle": "automatic",
    "primaryColor": "#19336E",
    "ios": {
      "bundleIdentifier": "com.ksaleshunter.admin",
      "buildNumber": "1",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleDisplayName": "케세헌",
        "CFBundleLocalizations": [
          "ko"
        ],
        "CFBundleDevelopmentRegion": "ko"
      }
    },
    "android": {
      "package": "com.ksaleshunter.admin",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#19336E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#19336E",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0E1420"
          }
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Pretendard-Regular.otf",
            "./assets/fonts/Pretendard-Medium.otf",
            "./assets/fonts/Pretendard-SemiBold.otf",
            "./assets/fonts/Pretendard-Bold.otf"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cc2f428a-d6f1-4888-bfa2-69128760c711"
      }
    },
    "owner": "nicerjs23",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/cc2f428a-d6f1-4888-bfa2-69128760c711"
    }
  }
}
